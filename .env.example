# Models — tiered on purpose. Classification runs on every inbound message including
# spam, so the cheap tier is where cost is controlled. Never hardcode these in an agent.
NAIB_MODEL_FAST=gpt-4.1-mini
NAIB_MODEL_STRONG=gpt-4.1

OPENAI_API_KEY=
OPENAI_AGENTS_DISABLE_TRACING=0

DATABASE_URL=postgresql+asyncpg://naib:naib@localhost:5432/naib
REDIS_URL=redis://localhost:6379/0

# Thresholds
NAIB_QUALIFY_CONFIDENCE_MIN=0.75
NAIB_ESCALATE_BELOW=0.60
NAIB_PRICE_FLOOR_PKR=0
NAIB_COST_BUDGET_USD_PER_LEAD=0.15
NAIB_MAX_ENRICHMENT_CALLS=4

# Safety. There is deliberately no flag that disables approval in v1.
NAIB_KILL_SWITCH=false
NAIB_AUTONOMY_LEVEL=draft_only
